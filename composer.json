{
    "name": "identifier/identifier",
    "description": "Common Interfaces and Factories for Identifiers",
    "license": "CC0-1.0",
    "type": "library",
    "keywords": [
        "guid",
        "id",
        "identifier",
        "snowflake",
        "uid",
        "ulid",
        "uuid"
    ],
    "support": {
        "issues": "https://github.com/php-identifier/identifier/issues",
        "security": "https://github.com/php-identifier/identifier/security/policy"
    },
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "captainhook/captainhook": "^5.29",
        "captainhook/plugin-composer": "^5.3",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "ergebnis/composer-normalize": "^2.52",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "ramsey/coding-standard": "^2.4",
        "ramsey/conventional-commits": "^1.7",
        "roave/security-advisories": "dev-latest"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Identifier\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Identifier\\StaticAnalysis\\": "tests/static-analysis/"
        }
    },
    "config": {
        "allow-plugins": {
            "captainhook/plugin-composer": true,
            "composer/package-versions-deprecated": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "extra": {
        "captainhook": {
            "force-install": true
        },
        "ramsey/conventional-commits": {
            "configFile": "conventional-commits.json"
        }
    },
    "scripts": {
        "analyze": "vendor/bin/phpstan analyze --ansi -v --memory-limit=1G",
        "fix": [
            "@composer normalize",
            "vendor/bin/phpcbf --cache=build/cache/phpcs.cache"
        ],
        "lint": [
            "@composer validate --strict",
            "@composer normalize --dry-run",
            "vendor/bin/phpcs --colors --cache=build/cache/phpcs.cache",
            "@analyze"
        ],
        "test": "@lint"
    },
    "scripts-descriptions": {
        "analyze": "Runs static analysis.",
        "fix": "Fixes coding standards violations and normalizes composer.json.",
        "lint": "Runs coding standards checks and static analysis.",
        "test": "Runs coding standards checks and static analysis (an alias of lint)."
    }
}
